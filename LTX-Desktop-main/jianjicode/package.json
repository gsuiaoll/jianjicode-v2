{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.1.0",
  "name": "jianjicode",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .husky",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "build": "tsc --ignoreDeprecations 6.0 --noEmitOnError false && node -e \"console.log('Build complete')\"",
    "dev": "bun run --conditions=browser ./src/index.ts",
    "serve": "bun run ./src/server.ts",
    "check": "biome check src/ ai/",
    "check:fix": "biome check --write src/ ai/",
    "format": "biome format --write src/ ai/",
    "electron:dev": "bun run electron:vite && electron .",
    "electron:build": "bun run electron:vite:build && electron-builder --config electron-builder.json",
    "electron:vite": "vite --config electron/vite.config.ts",
    "electron:vite:build": "vite build",
    "postinstall": "electron-builder install-app-deps"
  },
  "bin": {
    "jianjicode": "./bin/jianjicode"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "lint-staged": {
    "*.ts": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "latest",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.5.0",
    "@types/string-similarity": "^4.0.2",
    "@types/yargs": "latest",
    "electron": "^33.4.0",
    "electron-builder": "^26.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "ts-node": "^10.9.2",
    "typescript": "latest",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.85",
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/azure": "^3.0.50",
    "@ai-sdk/cerebras": "^2.0.41",
    "@ai-sdk/cohere": "^3.0.27",
    "@ai-sdk/deepinfra": "^2.0.41",
    "@ai-sdk/google": "^3.0.54",
    "@ai-sdk/google-vertex": "^4.0.97",
    "@ai-sdk/groq": "^3.0.31",
    "@ai-sdk/mistral": "^3.0.27",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@ai-sdk/perplexity": "^3.0.26",
    "@ai-sdk/provider": "^2.0.0",
    "@ai-sdk/togetherai": "^2.0.41",
    "@ai-sdk/vercel": "^2.0.39",
    "@ai-sdk/xai": "^3.0.75",
    "@aws-sdk/credential-providers": "^3.1021.0",
    "@effect/platform-node": "^0.106.0",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "@types/semver": "^7.7.1",
    "ai": "^6.0.142",
    "effect": "^3.21.2",
    "electron-log": "^5.1.2",
    "ffmpeg-static": "^5.2.0",
    "fuzzysort": "^3.0.0",
    "google-auth-library": "^10.6.2",
    "hono": "^4.12.14",
    "jsonc-parser": "^3.3.1",
    "remeda": "^2.33.7",
    "semver": "^7.7.4",
    "string-similarity": "^4.0.4",
    "yargs": "^17.0.0",
    "zod": "^4.0.0"
  }
}
